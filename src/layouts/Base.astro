---
import "../styles/global.css";
import { pageColors } from "../data/colors";

interface Props {
  title: string;
  description?: string;
  currentPage?: "index" | "projects" | "about" | "contact";
  colorIndex?: number;
  layout?: "square" | "split";
  staticFit?: boolean;
}

const {
  title,
  description = "Architecture, computational design, and audiovisual work by Sebastián Ortiz de Zevallos.",
  currentPage = "index",
  colorIndex = 0,
  layout = "square",
  staticFit = false,
} = Astro.props;

const { square, backdrop, ink, inkBackdrop } = pageColors(colorIndex);
const inkClass = ink === "#ffffff" ? "ink-light" : "ink-dark";
---

<!DOCTYPE html>
<html lang="en" data-backdrop={backdrop}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      // Paint the previous backdrop instantly to avoid a color flash on load;
      // the canvas then slowly dissolves to this page's backdrop.
      try {
        var prev = sessionStorage.getItem("fxBackdrop");
        document.documentElement.style.backgroundColor =
          prev || document.documentElement.dataset.backdrop;
      } catch (e) {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Playfair+Display:ital,wght@1,400;1,500;1,600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class={inkClass} style={`--paper:${square};--backdrop:${backdrop};--ink:${ink};--ink-corner:${inkBackdrop};`}>
    <canvas id="fx"></canvas>

    <div class="corners">
      <nav class="corners__nav site-nav">
        <a href="/" aria-current={currentPage === "index" ? "page" : undefined}>Index</a>
        <a href="/about" aria-current={currentPage === "about" ? "page" : undefined}>About</a>
        <a href="/contact" aria-current={currentPage === "contact" ? "page" : undefined}>Contact</a>
      </nav>
      <div class="corners__name">
        <a href="/">Sebastián Ortiz de Zevallos</a>
      </div>
    </div>

    <div class="frame">
      {layout === "split" ? (
        <div class="squares">
          <section class="square square--content">
            <a class="back-btn" href="/" aria-label="Back to index">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <div class="square__scroll">
              <main>
                <slot />
              </main>
            </div>
          </section>
          <section class="square square--gallery">
            <div class="square__center">
              <slot name="gallery" />
            </div>
          </section>
        </div>
      ) : (
        <section class="square square--single">
          <div class={`square__scroll${staticFit ? " square__scroll--static" : ""}`}>
            <main>
              <slot />
            </main>
          </div>
        </section>
      )}
    </div>

    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
      <button class="lightbox__close" type="button" aria-label="Close">×</button>
      <figure class="lightbox__figure">
        <div class="lightbox__imgwrap">
          <img src="" alt="" />
          <button class="lightbox__zoom" type="button" aria-label="Zoom image">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
              <line x1="16" y1="16" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              <line x1="11" y1="8" x2="11" y2="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              <line x1="8" y1="11" x2="14" y2="11" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </button>
        </div>
        <figcaption class="lightbox__caption">
          <h3 class="lightbox__title"></h3>
          <p class="lightbox__desc"></p>
        </figcaption>
      </figure>
    </div>

    <script>
      // ---- Slow, organic Perlin-noise backdrop dissolve --------------------
      // Only the outside background transitions; squares cut instantly.
      function hexToRgb(h) {
        h = (h || "").trim().replace("#", "");
        if (h.length === 3) h = h.split("").map((c) => c + c).join("");
        const n = parseInt(h || "000000", 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }

      function makeNoise(seed) {
        const p = new Uint8Array(256);
        for (let i = 0; i < 256; i++) p[i] = i;
        let s = (seed >>> 0) || 1;
        for (let i = 255; i > 0; i--) {
          s = (s * 1664525 + 1013904223) >>> 0;
          const j = s % (i + 1);
          const t = p[i]; p[i] = p[j]; p[j] = t;
        }
        const perm = new Uint8Array(512);
        for (let i = 0; i < 512; i++) perm[i] = p[i & 255];
        const fade = (t) => t * t * t * (t * (t * 6 - 15) + 10);
        const lerp = (a, b, t) => a + (b - a) * t;
        const grad = (h, x, y) => ((h & 1) ? -x : x) + ((h & 2) ? -y : y);
        return (x, y) => {
          const X = Math.floor(x) & 255, Y = Math.floor(y) & 255;
          const xf = x - Math.floor(x), yf = y - Math.floor(y);
          const u = fade(xf), v = fade(yf);
          const aa = perm[perm[X] + Y], ab = perm[perm[X] + Y + 1];
          const ba = perm[perm[X + 1] + Y], bb = perm[perm[X + 1] + Y + 1];
          const x1 = lerp(grad(aa, xf, yf), grad(ba, xf - 1, yf), u);
          const x2 = lerp(grad(ab, xf, yf - 1), grad(bb, xf - 1, yf - 1), u);
          const n = lerp(x1, x2, v) * 0.5 + 0.5;
          return n < 0 ? 0 : n > 1 ? 1 : n;
        };
      }

      function initFx() {
        const canvas = document.getElementById("fx");
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        const CELL = 18;
        const EDGE = 0.16;

        const newBackdrop =
          (document.documentElement.dataset.backdrop ||
            getComputedStyle(document.body).getPropertyValue("--backdrop")).trim();

        // Fresh noise parameters per dissolve (set in kick()).
        let noise = makeNoise(1);
        let SCALE = 0.03, OFFX = 0, OFFY = 0, DURATION = 8000;

        let cols = 0, rows = 0, field = null;
        const sizeCanvas = () => {
          const dpr = Math.min(devicePixelRatio || 1, 2);
          canvas.width = Math.ceil(innerWidth * dpr);
          canvas.height = Math.ceil(innerHeight * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          cols = Math.ceil(innerWidth / CELL) + 1;
          rows = Math.ceil(innerHeight / CELL) + 1;
          field = new Float32Array(cols * rows);
          for (let j = 0; j < rows; j++)
            for (let i = 0; i < cols; i++)
              field[j * cols + i] = noise(OFFX + i * SCALE, OFFY + j * SCALE);
        };

        const fill = (color) => {
          ctx.fillStyle = color;
          ctx.fillRect(0, 0, innerWidth, innerHeight);
        };

        const smooth = (e0, e1, x) => {
          const t = Math.min(1, Math.max(0, (x - e0) / (e1 - e0)));
          return t * t * (3 - 2 * t);
        };

        // Save per-cell pixel state so the next page can resume from here.
        const saveSnapshot = () => {
          if (!cols || !rows) return;
          const cells = [];
          for (let j = 0; j < rows; j++) {
            for (let i = 0; i < cols; i++) {
              const px = ctx.getImageData(i * CELL + (CELL >> 1), j * CELL + (CELL >> 1), 1, 1).data;
              cells.push(px[0] + "," + px[1] + "," + px[2]);
            }
          }
          try { sessionStorage.setItem("fxCells", JSON.stringify(cells)); } catch (e) {}
        };

        let rafId = null;

        const setPaperOp = (v) => {
          document.body.style.setProperty("--paper-op", String(v));
        };

        // Squares ramp 75% -> 100% at a steady pace: they reach 87.5% exactly
        // when the dissolve finishes, then keep climbing at the same rate for
        // another full duration to land at 100% (so total ramp = 2x DURATION).
        const rampPaperOp = () => {
          const opStart = performance.now();
          const opDur = DURATION * 2;
          setPaperOp(75);
          const opFrame = (now) => {
            const q = Math.min(1, (now - opStart) / opDur);
            setPaperOp(75 + 25 * q);
            if (q < 1) requestAnimationFrame(opFrame);
          };
          requestAnimationFrame(opFrame);
        };

        // animate supports:
        //  - from as a hex string (uniform start color)
        //  - fromCells as a string[] per cell (mid-dissolve snapshot)
        const animate = (from, to, fromCells) => {
          const b = hexToRgb(to);
          const uniformA = from ? hexToRgb(from) : null;
          const start = performance.now();
          rampPaperOp();
          const frame = (now) => {
            const p = Math.min(1, (now - start) / DURATION);
            const pp = p * (1 + 2 * EDGE);
            for (let j = 0; j < rows; j++) {
              for (let i = 0; i < cols; i++) {
                const idx = j * cols + i;
                let a;
                if (fromCells && idx < fromCells.length) {
                  const parts = fromCells[idx].split(",");
                  a = [+parts[0], +parts[1], +parts[2]];
                } else {
                  a = uniformA || [b[0], b[1], b[2]];
                }
                const n = field[idx];
                const t = smooth(n - EDGE, n + EDGE, pp);
                const r = (a[0] + (b[0] - a[0]) * t) | 0;
                const g = (a[1] + (b[1] - a[1]) * t) | 0;
                const bl = (a[2] + (b[2] - a[2]) * t) | 0;
                ctx.fillStyle = "rgb(" + r + "," + g + "," + bl + ")";
                ctx.fillRect(i * CELL, j * CELL, CELL + 1, CELL + 1);
              }
            }
            if (p < 1) { rafId = requestAnimationFrame(frame); }
            else { rafId = null; fill(to); }
          };
          rafId = requestAnimationFrame(frame);
        };

        // Start (or restart) a dissolve from the stored state to this page's
        // backdrop. Called on load and on pageshow (back/forward cache).
        const kick = () => {
          const seed = (Math.random() * 4294967295) >>> 0;
          noise = makeNoise(seed);
          SCALE = 0.022 + Math.random() * 0.02;
          OFFX = Math.random() * 1000;
          OFFY = Math.random() * 1000;
          DURATION = 6000 + Math.random() * 4000;

          let prevBackdrop = null;
          let cellSnapshot = null;
          let samePage = false;
          try {
            prevBackdrop = sessionStorage.getItem("fxBackdrop");
            const snap = sessionStorage.getItem("fxCells");
            if (snap) {
              cellSnapshot = JSON.parse(snap);
              sessionStorage.removeItem("fxCells");
            }
            const prevPath = sessionStorage.getItem("fxPath");
            samePage = prevPath === location.pathname;
            sessionStorage.setItem("fxPath", location.pathname);
          } catch (e) {}
          try {
            sessionStorage.setItem("fxBackdrop", newBackdrop);
          } catch (e) {}

          if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
          sizeCanvas();

          const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (!reduced && !samePage && (cellSnapshot || (prevBackdrop && prevBackdrop !== newBackdrop)))
            animate(prevBackdrop, newBackdrop, cellSnapshot);
          else fill(newBackdrop);
        };

        // Snapshot canvas cells just before the page is hidden so the next
        // page (or this page on back/forward) can continue the dissolve.
        window.addEventListener("pagehide", saveSnapshot);
        window.addEventListener("beforeunload", saveSnapshot);

        // Back/forward cache restore: scripts don't re-run, so re-kick here.
        window.addEventListener("pageshow", (e) => {
          if (e.persisted) kick();
        });

        let rt;
        addEventListener("resize", () => {
          clearTimeout(rt);
          rt = setTimeout(() => {
            sizeCanvas();
            fill(newBackdrop);
          }, 120);
        });

        kick();
      }

      // ---- Lightbox gallery viewer ----------------------------------------
      function initLightbox() {
        const box = document.getElementById("lightbox");
        if (!box) return;
        const img = box.querySelector("img");
        const wrap = box.querySelector(".lightbox__imgwrap");
        const zoomBtn = box.querySelector(".lightbox__zoom");
        const titleEl = box.querySelector(".lightbox__title");
        const descEl = box.querySelector(".lightbox__desc");
        let items = [];
        let idx = 0;
        let zoomed = false;

        const setZoom = (on) => {
          zoomed = on;
          if (wrap) wrap.classList.toggle("is-zoomed", on);
          if (!on) img.style.transformOrigin = "center center";
        };

        const render = () => {
          const it = items[idx];
          if (!it) return;
          setZoom(false);
          img.src = it.src || "";
          img.alt = it.alt || "";
          titleEl.textContent = it.title || "";
          descEl.textContent = it.desc || "";
        };
        const open = (list, start) => {
          items = list;
          idx = start;
          render();
          box.classList.add("is-open");
          box.setAttribute("aria-hidden", "false");
        };
        const close = () => {
          setZoom(false);
          box.classList.remove("is-open");
          box.setAttribute("aria-hidden", "true");
          img.src = "";
        };
        const move = (d) => {
          if (!items.length) return;
          idx = (idx + d + items.length) % items.length;
          render();
        };

        // Zoom: the magnifier toggles; moving the cursor over the image pans it
        zoomBtn?.addEventListener("click", (e) => { e.stopPropagation(); setZoom(!zoomed); });
        wrap?.addEventListener("click", (e) => {
          if (e.target.closest(".lightbox__zoom")) return;
          if (zoomed) setZoom(false);
        });
        wrap?.addEventListener("mousemove", (e) => {
          if (!zoomed) return;
          const r = wrap.getBoundingClientRect();
          const px = ((e.clientX - r.left) / r.width) * 100;
          const py = ((e.clientY - r.top) / r.height) * 100;
          img.style.transformOrigin = `${px}% ${py}%`;
        });

        // Build a list per gallery from its (non-clone) thumbnails
        document.querySelectorAll("[data-carousel]").forEach((c) => {
          const links = Array.from(c.querySelectorAll(".carousel__item")).filter(
            (a) => !a.hasAttribute("data-clone")
          );
          const list = links.map((a) => ({
            src: a.getAttribute("href"),
            alt: a.getAttribute("data-alt") || "",
            title: a.getAttribute("data-title") || "",
            desc: a.getAttribute("data-desc") || "",
          }));
          links.forEach((a, i) => {
            a.addEventListener("click", (e) => {
              e.preventDefault();
              // Only zoom when the image itself is clicked (not blank space)
              if (e.target.closest("img")) open(list, i);
            });
          });
        });

        // Click on the dark backdrop (not the image/caption) closes
        box.addEventListener("click", (e) => {
          if (e.target.closest(".lightbox__figure")) return;
          close();
        });

        // Scroll / swipe to advance to the next image
        box.addEventListener(
          "wheel",
          (e) => {
            if (!box.classList.contains("is-open")) return;
            e.preventDefault();
            move(e.deltaY > 0 ? 1 : -1);
          },
          { passive: false }
        );
        let sy = null;
        box.addEventListener("touchstart", (e) => { sy = e.touches[0].clientY; }, { passive: true });
        box.addEventListener(
          "touchmove",
          (e) => {
            if (sy === null) return;
            const dy = sy - e.touches[0].clientY;
            if (Math.abs(dy) > 40) { move(dy > 0 ? 1 : -1); sy = e.touches[0].clientY; }
            e.preventDefault();
          },
          { passive: false }
        );

        document.addEventListener("keydown", (e) => {
          if (!box.classList.contains("is-open")) return;
          if (e.key === "Escape") close();
          else if (e.key === "ArrowDown" || e.key === "ArrowRight") move(1);
          else if (e.key === "ArrowUp" || e.key === "ArrowLeft") move(-1);
        });
      }

      // ---- Scroll anywhere -------------------------------------------------
      // Wheel and touch anywhere on the page scroll the main vertical scroller
      // (the single/content square). Over the gallery track, its own handler
      // takes the horizontal scroll instead.
      function initScroll() {
        // The index page handles its own section/scroll logic.
        if (document.querySelector(".index")) return;
        const scroller = document.querySelector(
          ".square--single .square__scroll, .square--content .square__scroll"
        );
        if (!scroller) return;

        const inGallery = (t) => t && t.closest && t.closest(".carousel__track");
        const lightbox = document.getElementById("lightbox");
        const lightboxOpen = () => lightbox && lightbox.classList.contains("is-open");

        window.addEventListener(
          "wheel",
          (e) => {
            // Lightbox is open → its own handler advances images; don't move
            // the page behind it.
            if (lightboxOpen()) return;
            if (inGallery(e.target)) return;
            scroller.scrollTop += e.deltaY;
            e.preventDefault();
          },
          { passive: false }
        );

        let startY = null;
        window.addEventListener(
          "touchstart",
          (e) => {
            startY = inGallery(e.target) || lightboxOpen() ? null : e.touches[0].clientY;
          },
          { passive: true }
        );
        window.addEventListener(
          "touchmove",
          (e) => {
            if (startY === null || lightboxOpen()) return;
            const y = e.touches[0].clientY;
            scroller.scrollTop += startY - y;
            startY = y;
            e.preventDefault();
          },
          { passive: false }
        );

        // Middle-button (wheel click) autoscroll that works anywhere on the
        // page, not just over a natively scrollable element. Click to start,
        // move the mouse up/down to scroll, click again to stop.
        let auto = null;
        const stopAuto = () => {
          if (!auto) return;
          cancelAnimationFrame(auto.raf);
          window.removeEventListener("mousemove", auto.onMove);
          document.body.style.cursor = "";
          auto = null;
        };
        window.addEventListener("mousedown", (e) => {
          if (auto) { stopAuto(); if (e.button === 1) e.preventDefault(); return; }
          if (e.button !== 1) return;
          if (inGallery(e.target) || lightboxOpen() || (e.target.closest && e.target.closest("a")))
            return;
          e.preventDefault();
          const anchor = e.clientY;
          const a = { raf: 0, cur: anchor, onMove: (ev) => { a.cur = ev.clientY; } };
          window.addEventListener("mousemove", a.onMove);
          document.body.style.cursor = "ns-resize";
          const tick = () => {
            const dy = a.cur - anchor;
            if (Math.abs(dy) > 8) scroller.scrollTop += dy * 0.08;
            a.raf = requestAnimationFrame(tick);
          };
          a.raf = requestAnimationFrame(tick);
          auto = a;
        });
      }

      // Mobile: horizontal swipe cycles Index → About → Contact (and back),
      // triggering the dissolve on navigation.
      function initSwipeNav() {
        if (!matchMedia("(max-width: 900px)").matches) return;
        const pages = ["/", "/about", "/contact"];
        let path = location.pathname.replace(/\/+$/, "");
        if (path === "") path = "/";
        const idx = pages.indexOf(path);
        if (idx === -1) return; // only on the three main pages
        const frame = document.querySelector(".frame");
        const go = (url, dir) => {
          if (frame) {
            frame.style.transition = "transform 0.28s ease, opacity 0.28s ease";
            frame.style.transform = `translateX(${dir * -32}vw)`;
            frame.style.opacity = "0";
          }
          setTimeout(() => { location.href = url; }, 240);
        };
        let sx = null, sy = null;
        window.addEventListener("touchstart", (e) => {
          sx = e.touches[0].clientX; sy = e.touches[0].clientY;
        }, { passive: true });
        window.addEventListener("touchend", (e) => {
          if (sx === null) return;
          const dx = e.changedTouches[0].clientX - sx;
          const dy = e.changedTouches[0].clientY - sy;
          sx = sy = null;
          if (Math.abs(dx) < 70 || Math.abs(dx) < Math.abs(dy) * 1.6) return;
          if (dx < 0 && idx < pages.length - 1) go(pages[idx + 1], 1);
          else if (dx > 0 && idx > 0) go(pages[idx - 1], -1);
        }, { passive: true });
      }

      function boot() {
        initFx();
        initLightbox();
        initScroll();
        initSwipeNav();
        // Returning to the index from a project should land on the list
        document.querySelector(".back-btn")?.addEventListener("click", () => {
          try { sessionStorage.setItem("indexSection", "list"); } catch (e) {}
        });
      }
      if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", boot);
      else boot();
    </script>
  </body>
</html>
