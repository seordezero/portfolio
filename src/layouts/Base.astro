---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  currentPage?: "index" | "projects" | "about" | "contact";
  theme?: "white" | "red" | "yellow" | "blue" | "black" | "green" | "pink";
  layout?: "square" | "split";
}

const {
  title,
  description = "Architecture, computational design, and audiovisual work by Sebastián Ortiz de Zevallos.",
  currentPage = "index",
  theme = "white",
  layout = "square",
} = Astro.props;

const corners = ["tl", "tr", "bl", "br"];
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Playfair+Display:ital,wght@1,400;1,500;1,600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class={`theme-${theme}`}>
    <div class="frame">
      {layout === "split" ? (
        <div class="squares">
          <section class="square square--content">
            {corners.map((c) => <span class={`dot dot--${c}`} />)}
            <div class="square__scroll">
              <header class="site-header">
                <div>
                  <div class="site-header__name">
                    <a href="/">Sebastián Ortiz de Zevallos</a>
                  </div>
                  <div class="site-header__tagline">
                    Architecture · Computation · Sound
                  </div>
                </div>
                <nav class="site-nav">
                  <a href="/" aria-current={currentPage === "index" ? "page" : undefined}>Index</a>
                  <a href="/about" aria-current={currentPage === "about" ? "page" : undefined}>About</a>
                  <a href="/contact" aria-current={currentPage === "contact" ? "page" : undefined}>Contact</a>
                </nav>
              </header>
              <main>
                <slot />
              </main>
              <footer class="site-footer">
                <div>Madrid · {year}</div>
                <div>seordezero@gmail.com</div>
              </footer>
            </div>
          </section>
          <section class="square square--gallery">
            {corners.map((c) => <span class={`dot dot--${c}`} />)}
            <div class="square__center">
              <slot name="gallery" />
            </div>
          </section>
        </div>
      ) : (
        <section class="square square--single">
          {corners.map((c) => <span class={`dot dot--${c}`} />)}
          <div class="square__scroll">
            <header class="site-header">
              <div>
                <div class="site-header__name">
                  <a href="/">Sebastián Ortiz de Zevallos</a>
                </div>
                <div class="site-header__tagline">
                  Architecture · Computation · Sound
                </div>
              </div>
              <nav class="site-nav">
                <a href="/" aria-current={currentPage === "index" ? "page" : undefined}>Index</a>
                <a href="/about" aria-current={currentPage === "about" ? "page" : undefined}>About</a>
                <a href="/contact" aria-current={currentPage === "contact" ? "page" : undefined}>Contact</a>
              </nav>
            </header>
            <main>
              <slot />
            </main>
            <footer class="site-footer">
              <div>Madrid · {year}</div>
              <div>seordezero@gmail.com</div>
            </footer>
          </div>
        </section>
      )}
    </div>

    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
      <button class="lightbox__close" type="button" aria-label="Close">×</button>
      <img src="" alt="" />
    </div>

    <script>
      const box = document.getElementById("lightbox");
      if (box) {
        const img = box.querySelector("img");
        const open = (src, alt) => {
          img.src = src;
          img.alt = alt || "";
          box.classList.add("is-open");
          box.setAttribute("aria-hidden", "false");
        };
        const close = () => {
          box.classList.remove("is-open");
          box.setAttribute("aria-hidden", "true");
          img.src = "";
        };
        document.querySelectorAll("[data-lightbox]").forEach((a) => {
          a.addEventListener("click", (e) => {
            e.preventDefault();
            open(a.getAttribute("href"), a.getAttribute("data-alt"));
          });
        });
        box.addEventListener("click", (e) => {
          if (e.target === img) return;
          close();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && box.classList.contains("is-open")) close();
        });
      }
    </script>
  </body>
</html>
