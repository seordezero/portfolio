---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  currentPage?: "index" | "projects" | "about" | "contact";
  theme?: "white" | "red" | "yellow" | "blue" | "black" | "green" | "pink";
  layout?: "square" | "split";
}

const {
  title,
  description = "Architecture, computational design, and audiovisual work by Sebastián Ortiz de Zevallos.",
  currentPage = "index",
  theme = "white",
  layout = "square",
} = Astro.props;

const backdrops: Record<string, string> = {
  white: "#e2231a",
  yellow: "#1b2ed6",
  pink: "#f5c400",
  red: "#111110",
  blue: "#111110",
  green: "#111110",
  black: "#e2231a",
};
const backdrop = backdrops[theme];
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en" data-backdrop={backdrop}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      // Paint the previous backdrop instantly to avoid a color flash on load;
      // the canvas then dissolves to this page's colors.
      try {
        var prev = sessionStorage.getItem("fxBackdrop");
        document.documentElement.style.backgroundColor =
          prev || document.documentElement.dataset.backdrop;
      } catch (e) {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Playfair+Display:ital,wght@1,400;1,500;1,600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class={`theme-${theme}`}>
    <canvas id="fx"></canvas>

    <div class="frame">
      {layout === "split" ? (
        <div class="squares">
          <section class="square square--content">
            <div class="square__scroll">
              <header class="site-header">
                <div>
                  <div class="site-header__name">
                    <a href="/">Sebastián Ortiz de Zevallos</a>
                  </div>
                  <div class="site-header__tagline">
                    Architecture · Computation · Sound
                  </div>
                </div>
                <nav class="site-nav">
                  <a href="/" aria-current={currentPage === "index" ? "page" : undefined}>Index</a>
                  <a href="/about" aria-current={currentPage === "about" ? "page" : undefined}>About</a>
                  <a href="/contact" aria-current={currentPage === "contact" ? "page" : undefined}>Contact</a>
                </nav>
              </header>
              <main>
                <slot />
              </main>
              <footer class="site-footer">
                <div>Madrid · {year}</div>
                <div>seordezero@gmail.com</div>
              </footer>
            </div>
          </section>
          <section class="square square--gallery">
            <div class="square__center">
              <slot name="gallery" />
            </div>
          </section>
        </div>
      ) : (
        <section class="square square--single">
          <div class="square__scroll">
            <header class="site-header">
              <div>
                <div class="site-header__name">
                  <a href="/">Sebastián Ortiz de Zevallos</a>
                </div>
                <div class="site-header__tagline">
                  Architecture · Computation · Sound
                </div>
              </div>
              <nav class="site-nav">
                <a href="/" aria-current={currentPage === "index" ? "page" : undefined}>Index</a>
                <a href="/about" aria-current={currentPage === "about" ? "page" : undefined}>About</a>
                <a href="/contact" aria-current={currentPage === "contact" ? "page" : undefined}>Contact</a>
              </nav>
            </header>
            <main>
              <slot />
            </main>
            <footer class="site-footer">
              <div>Madrid · {year}</div>
              <div>seordezero@gmail.com</div>
            </footer>
          </div>
        </section>
      )}
    </div>

    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
      <button class="lightbox__close" type="button" aria-label="Close">×</button>
      <img src="" alt="" />
    </div>

    <script>
      // ---- Perlin-noise background dissolve --------------------------------
      function hexToRgb(h) {
        h = (h || "").trim().replace("#", "");
        if (h.length === 3) h = h.split("").map((c) => c + c).join("");
        const n = parseInt(h || "000000", 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }

      function makeNoise(seed) {
        const p = new Uint8Array(256);
        for (let i = 0; i < 256; i++) p[i] = i;
        let s = seed >>> 0;
        for (let i = 255; i > 0; i--) {
          s = (s * 1664525 + 1013904223) >>> 0;
          const j = s % (i + 1);
          const t = p[i]; p[i] = p[j]; p[j] = t;
        }
        const perm = new Uint8Array(512);
        for (let i = 0; i < 512; i++) perm[i] = p[i & 255];
        const fade = (t) => t * t * t * (t * (t * 6 - 15) + 10);
        const lerp = (a, b, t) => a + (b - a) * t;
        const grad = (h, x, y) => ((h & 1) ? -x : x) + ((h & 2) ? -y : y);
        return (x, y) => {
          const X = Math.floor(x) & 255, Y = Math.floor(y) & 255;
          const xf = x - Math.floor(x), yf = y - Math.floor(y);
          const u = fade(xf), v = fade(yf);
          const aa = perm[perm[X] + Y], ab = perm[perm[X] + Y + 1];
          const ba = perm[perm[X + 1] + Y], bb = perm[perm[X + 1] + Y + 1];
          const x1 = lerp(grad(aa, xf, yf), grad(ba, xf - 1, yf), u);
          const x2 = lerp(grad(ab, xf, yf - 1), grad(bb, xf - 1, yf - 1), u);
          const n = lerp(x1, x2, v) * 0.5 + 0.5;
          return n < 0 ? 0 : n > 1 ? 1 : n;
        };
      }

      const noise = makeNoise(20260623);

      function initFx() {
        const canvas = document.getElementById("fx");
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        const CELL = 16;        // dot/cell size in px
        const SCALE = 0.05;     // low-scale Perlin → big organic waves
        const DURATION = 950;   // ms
        const EDGE = 0.13;      // softness of the wave front

        const readState = () => {
          const backdrop = (
            document.documentElement.dataset.backdrop ||
            getComputedStyle(document.body).getPropertyValue("--backdrop")
          ).trim();
          const squares = Array.from(document.querySelectorAll(".square")).map((sq) => {
            const r = sq.getBoundingClientRect();
            const color = getComputedStyle(sq).getPropertyValue("--paper").trim();
            return { x: r.left, y: r.top, w: r.width, h: r.height, color };
          });
          return { backdrop, squares, vw: innerWidth, vh: innerHeight };
        };

        const colorAt = (state, px, py) => {
          for (const s of state.squares) {
            if (px >= s.x && px < s.x + s.w && py >= s.y && py < s.y + s.h)
              return s.color;
          }
          return state.backdrop;
        };

        let cur = readState();
        let prev = null;
        try {
          const raw = sessionStorage.getItem("fxState");
          if (raw) prev = JSON.parse(raw);
        } catch (e) {}

        const save = () => {
          try {
            sessionStorage.setItem("fxState", JSON.stringify(cur));
            sessionStorage.setItem("fxBackdrop", cur.backdrop);
          } catch (e) {}
        };

        let cols = 0, rows = 0, field = null;
        const sizeCanvas = () => {
          const dpr = Math.min(devicePixelRatio || 1, 2);
          canvas.width = Math.ceil(innerWidth * dpr);
          canvas.height = Math.ceil(innerHeight * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          cols = Math.ceil(innerWidth / CELL) + 1;
          rows = Math.ceil(innerHeight / CELL) + 1;
          field = new Float32Array(cols * rows);
          for (let j = 0; j < rows; j++)
            for (let i = 0; i < cols; i++)
              field[j * cols + i] = noise(i * SCALE, j * SCALE);
        };

        const paintStatic = (state) => {
          for (let j = 0; j < rows; j++) {
            for (let i = 0; i < cols; i++) {
              const px = i * CELL + CELL / 2, py = j * CELL + CELL / 2;
              ctx.fillStyle = colorAt(state, px, py);
              ctx.fillRect(i * CELL, j * CELL, CELL + 1, CELL + 1);
            }
          }
        };

        const smooth = (e0, e1, x) => {
          const t = Math.min(1, Math.max(0, (x - e0) / (e1 - e0)));
          return t * t * (3 - 2 * t);
        };

        const animate = (from) => {
          const start = performance.now();
          const frame = (now) => {
            const p = Math.min(1, (now - start) / DURATION);
            const pp = p * (1 + 2 * EDGE);
            for (let j = 0; j < rows; j++) {
              for (let i = 0; i < cols; i++) {
                const px = i * CELL + CELL / 2, py = j * CELL + CELL / 2;
                const n = field[j * cols + i];
                const t = smooth(n - EDGE, n + EDGE, pp);
                const a = hexToRgb(colorAt(from, px, py));
                const b = hexToRgb(colorAt(cur, px, py));
                const r = (a[0] + (b[0] - a[0]) * t) | 0;
                const g = (a[1] + (b[1] - a[1]) * t) | 0;
                const bl = (a[2] + (b[2] - a[2]) * t) | 0;
                ctx.fillStyle = "rgb(" + r + "," + g + "," + bl + ")";
                ctx.fillRect(i * CELL, j * CELL, CELL + 1, CELL + 1);
              }
            }
            if (p < 1) requestAnimationFrame(frame);
            else paintStatic(cur);
          };
          requestAnimationFrame(frame);
        };

        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

        sizeCanvas();
        if (prev && !reduced) animate(prev);
        else paintStatic(cur);
        save();

        let rt;
        addEventListener("resize", () => {
          clearTimeout(rt);
          rt = setTimeout(() => {
            cur = readState();
            sizeCanvas();
            paintStatic(cur);
            save();
          }, 120);
        });
      }

      // ---- Lightbox --------------------------------------------------------
      function initLightbox() {
        const box = document.getElementById("lightbox");
        if (!box) return;
        const img = box.querySelector("img");
        const open = (src, alt) => {
          img.src = src || "";
          img.alt = alt || "";
          box.classList.add("is-open");
          box.setAttribute("aria-hidden", "false");
        };
        const close = () => {
          box.classList.remove("is-open");
          box.setAttribute("aria-hidden", "true");
          img.src = "";
        };
        document.querySelectorAll("[data-lightbox]").forEach((a) => {
          a.addEventListener("click", (e) => {
            e.preventDefault();
            open(a.getAttribute("href"), a.getAttribute("data-alt"));
          });
        });
        box.addEventListener("click", (e) => {
          if (e.target !== img) close();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && box.classList.contains("is-open")) close();
        });
      }

      function boot() {
        initFx();
        initLightbox();
      }
      if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", boot);
      else boot();
    </script>
  </body>
</html>
