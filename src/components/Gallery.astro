---
interface Props {
  slug: string;
  images: string[]; // full-res filenames with extension, in order
  alt?: string;
}
const { slug, images, alt = "" } = Astro.props;
---

<div class="carousel" data-carousel>
  <div class="carousel__track" data-track>
    {images.map((file, i) => {
      const n = String(i + 1).padStart(2, "0");
      const label = `${alt} — image ${i + 1}`;
      return (
        <a
          class="carousel__item"
          href={`/images/${slug}/full/${file}`}
          data-lightbox
          data-alt={label}
          aria-label={label}
        >
          <img
            src={`/images/${slug}/thumb/${n}.jpg`}
            alt={label}
            width="512"
            height="512"
            loading="lazy"
          />
        </a>
      );
    })}
  </div>

  {images.length > 1 && (
    <>
      <button class="carousel__arrow carousel__arrow--prev" data-prev aria-label="Previous image">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="carousel__arrow carousel__arrow--next" data-next aria-label="Next image">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </>
  )}
</div>

<script>
  function initCarousels() {
    document.querySelectorAll("[data-carousel]").forEach((c) => {
      if (c.dataset.ready) return;
      c.dataset.ready = "1";
      const track = c.querySelector("[data-track]");
      if (!track) return;

      const step = () => track.clientWidth;
      const reals = Array.from(track.children);
      const n = reals.length;

      if (n > 1) {
        // Seamless infinite loop: clone last before first and first after
        // last, so moving past either end continues in the same direction.
        const firstClone = reals[0].cloneNode(true);
        const lastClone = reals[n - 1].cloneNode(true);
        firstClone.setAttribute("data-clone", "");
        lastClone.setAttribute("data-clone", "");
        track.insertBefore(lastClone, reals[0]);
        track.appendChild(firstClone);

        const toFirst = () => { track.scrollLeft = step(); };
        requestAnimationFrame(toFirst);
        window.addEventListener("resize", toFirst);

        let normTimer;
        track.addEventListener("scroll", () => {
          clearTimeout(normTimer);
          normTimer = setTimeout(() => {
            const w = step();
            const x = track.scrollLeft;
            if (x < w * 0.5) track.scrollLeft = w * n;        // last clone -> real last
            else if (x > w * (n + 0.5)) track.scrollLeft = w; // first clone -> real first
          }, 90);
        });

        c.querySelector("[data-prev]")?.addEventListener("click", () =>
          track.scrollBy({ left: -step(), behavior: "smooth" })
        );
        c.querySelector("[data-next]")?.addEventListener("click", () =>
          track.scrollBy({ left: step(), behavior: "smooth" })
        );
      }

      // Vertical wheel / trackpad → horizontal scroll (Instagram-style)
      track.addEventListener(
        "wheel",
        (e) => {
          if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
            track.scrollLeft += e.deltaY;
            e.preventDefault();
          }
        },
        { passive: false }
      );
    });
  }
  if (document.readyState === "loading")
    document.addEventListener("DOMContentLoaded", initCarousels);
  else initCarousels();
</script>
