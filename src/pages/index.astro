---
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects";

const sorted = [...projects].sort((a, b) => b.year - a.year);
---

<Base title="Sebastián Ortiz de Zevallos" currentPage="index" colorIndex={0}>
  <div class="index__intro" data-intro>
    <p class="lede">
      Parametric systems, sonic landscapes, and architectural research from <em>Madrid &amp; Lima</em>.
    </p>
    <button class="scroll-cue" data-cue type="button" aria-label="Scroll to projects">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <section class="index" aria-label="Project index" data-view="list">
    <div class="index__top">
      <button type="button" class="index__viewbtn index__viewbtn--list" data-view-btn="list" aria-pressed="true" aria-label="List view" title="List view">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </button>

      <button class="scroll-cue scroll-cue--up" data-cue-up type="button" aria-label="Back to intro">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M5 15l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <button type="button" class="index__viewbtn index__viewbtn--grid" data-view-btn="grid" aria-pressed="false" aria-label="Catalog view" title="Catalog view">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <rect x="4" y="4" width="6.5" height="6.5" />
          <rect x="13.5" y="4" width="6.5" height="6.5" />
          <rect x="4" y="13.5" width="6.5" height="6.5" />
          <rect x="13.5" y="13.5" width="6.5" height="6.5" />
        </svg>
      </button>
    </div>

    <div class="index__body">
      <div class="index__list" data-list>
        {
          sorted.map((project) => (
            <a
              class="index__row"
              href={`/projects/${project.slug}`}
              data-year={project.year}
              data-title={project.title.toLowerCase()}
              data-category={project.category.toLowerCase()}
            >
              <div class="index__year">{project.year}</div>
              <div class="index__name">
                <span class="index__title">{project.title}</span>
                {project.subtitle && (
                  <span class="index__subtitle">— {project.subtitle}</span>
                )}
              </div>
              <div class="index__category">{project.category}</div>
            </a>
          ))
        }
      </div>

      <div class="index__catalog" data-catalog>
        {
          sorted.map((project) => (
            <a
              class="catalog__item"
              href={`/projects/${project.slug}`}
              data-year={project.year}
              data-title={project.title.toLowerCase()}
              data-category={project.category.toLowerCase()}
            >
              <img
                class="catalog__thumb"
                src={`/images/${project.slug}/thumb/${String(project.cover ?? 1).padStart(2, "0")}.jpg`}
                alt={project.title}
                width="512"
                height="512"
                loading="lazy"
              />
              <span class="catalog__title">{project.title}</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="index__head">
      <div role="button" tabindex="0" data-sort="year" aria-pressed="true">Year</div>
      <div role="button" tabindex="0" data-sort="title" aria-pressed="false">Project</div>
      <div role="button" tabindex="0" data-sort="category" aria-pressed="false">Category</div>
    </div>
  </section>

  <script>
    function initIndex() {
      const index = document.querySelector(".index");
      const head = document.querySelector(".index__head");
      const list = document.querySelector("[data-list]");
      const catalog = document.querySelector("[data-catalog]");
      if (!index || !head || !list || index.dataset.ready) return;
      index.dataset.ready = "1";

      let key = "year";
      let dir = -1;

      const valueOf = (el, k) =>
        k === "year" ? Number(el.dataset.year) : el.dataset[k];

      const sortContainer = (container) => {
        Array.from(container.children)
          .sort((a, b) => {
            const va = valueOf(a, key);
            const vb = valueOf(b, key);
            if (va < vb) return -1 * dir;
            if (va > vb) return 1 * dir;
            return 0;
          })
          .forEach((el) => container.appendChild(el));
      };

      const apply = () => {
        sortContainer(list);
        if (catalog) sortContainer(catalog);
      };

      head.querySelectorAll("[data-sort]").forEach((col) => {
        col.addEventListener("click", () => {
          const k = col.dataset.sort;
          if (k === key) {
            dir *= -1;
          } else {
            key = k;
            dir = k === "year" ? -1 : 1;
          }
          head.querySelectorAll("[data-sort]").forEach((c) =>
            c.setAttribute("aria-pressed", c === col ? "true" : "false")
          );
          apply();
        });
        col.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); col.click(); }
        });
      });

      // Two sections — cover (phrase) and list — only one shown at a time.
      // Scrolling anywhere on the page moves between them, with a pause at the
      // list's top edge: reach the top of the list first, then a further scroll
      // up returns to the phrase. The current section is remembered so coming
      // back from a project lands on the list, not the phrase.
      const intro = document.querySelector("[data-intro]");
      const body = document.querySelector(".index__body");
      const cue = document.querySelector("[data-cue]");
      const cueUp = document.querySelector("[data-cue-up]");
      const KEY = "indexSection";
      let section = "cover";

      // Mobile: size list rows so 4 are visible and the catalog so a 2x2 fits
      // exactly, both centered in the body, with one-row snapping.
      const isMobile = () => matchMedia("(max-width: 640px)").matches;
      const rowEls = list ? Array.from(list.children) : [];
      const layoutMobile = () => {
        const clear = () => {
          rowEls.forEach((r) => { r.style.height = ""; });
          if (catalog) {
            catalog.style.gridTemplateColumns = "";
            catalog.style.gridAutoRows = "";
            catalog.style.width = "";
          }
        };
        if (!body || !isMobile() || section !== "list") { clear(); return; }
        const bh = body.clientHeight;
        const bw = body.clientWidth;
        if (bh < 60) return;
        const rowH = Math.floor(bh / 4);
        rowEls.forEach((r) => { r.style.height = rowH + "px"; });
        // Grid: one big row of two images at a time (cell = half the width)
        const gap = 5;
        const cell = Math.floor((bw - gap) / 2);
        if (catalog) {
          catalog.style.gridTemplateColumns = `repeat(2, ${cell}px)`;
          catalog.style.gridAutoRows = `${cell}px`;
          catalog.style.width = cell * 2 + gap + "px";
        }
      };

      const remember = (v) => { try { sessionStorage.setItem(KEY, v); } catch (e) {} };
      const showCover = () => {
        section = "cover";
        if (intro) intro.style.display = "";
        index.style.display = "none";
        remember("cover");
        layoutMobile();
      };
      const showList = () => {
        section = "list";
        if (intro) intro.style.display = "none";
        index.style.display = "";
        if (body) body.scrollTop = 0;
        remember("list");
        layoutMobile();
      };

      let saved = null;
      try { saved = sessionStorage.getItem(KEY); } catch (e) {}
      if (saved === "list") showList();
      else showCover();

      // Sections change only by clicking the arrows. Within the list/grid the
      // body scrolls natively (smooth, with snap-on-stop).
      cue?.addEventListener("click", showList);
      cueUp?.addEventListener("click", showCover);

      // View toggle: list (detail) vs grid (catalog)
      index.querySelectorAll("[data-view-btn]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const view = btn.dataset.viewBtn;
          index.dataset.view = view;
          index.querySelectorAll("[data-view-btn]").forEach((b) =>
            b.setAttribute("aria-pressed", b === btn ? "true" : "false")
          );
          if (body) body.scrollTop = 0;
          layoutMobile();
        });
      });

      let rt;
      window.addEventListener("resize", () => {
        clearTimeout(rt);
        rt = setTimeout(layoutMobile, 120);
      });
    }
    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", initIndex);
    else initIndex();
  </script>
</Base>
