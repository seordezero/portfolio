---
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects";

const sorted = [...projects].sort((a, b) => b.year - a.year);
---

<Base title="Sebastián Ortiz de Zevallos" currentPage="index">
  <p class="lede">
    Parametric systems, sonic landscapes, and architectural research from <em>Madrid &amp; Lima</em>.
  </p>

  <section class="index" aria-label="Project index">
    <div class="index__head">
      <div>Year</div>
      <div>Project</div>
      <div>Category</div>
      <div>No.</div>
    </div>

    {
      sorted.map((project, i) => (
        <a class="index__row" href={`/projects/${project.slug}`}>
          <div class="index__year">{project.year}</div>
          <div>
            <span class="index__title">{project.title}</span>
            {project.subtitle && (
              <span class="index__subtitle">— {project.subtitle}</span>
            )}
          </div>
          <div class="index__category">{project.category}</div>
          <div class="index__num">{String(i + 1).padStart(2, "0")}</div>
        </a>
      ))
    }
  </section>

  <div class="meta">
    <div>{sorted.length} projects · sorted by year</div>
    <div>Madrid · {new Date().getFullYear()}</div>
  </div>
</Base>
