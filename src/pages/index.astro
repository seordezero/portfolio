---
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects";

const sorted = [...projects].sort((a, b) => b.year - a.year);
const year = new Date().getFullYear();
---

<Base title="Sebastián Ortiz de Zevallos" currentPage="index" colorIndex={0}>
  <p class="lede">
    Parametric systems, sonic landscapes, and architectural research from <em>Madrid &amp; Lima</em>.
  </p>

  <section class="index" aria-label="Project index">
    <div class="index__head">
      <div role="button" tabindex="0" data-sort="year" aria-pressed="true">Year</div>
      <div role="button" tabindex="0" data-sort="title" aria-pressed="false">Project</div>
      <div role="button" tabindex="0" data-sort="category" aria-pressed="false">Category</div>
    </div>

    <div class="index__list" data-list>
      {
        sorted.map((project) => (
          <a
            class="index__row"
            href={`/projects/${project.slug}`}
            data-year={project.year}
            data-title={project.title.toLowerCase()}
            data-category={project.category.toLowerCase()}
          >
            <div class="index__year">{project.year}</div>
            <div>
              <span class="index__title">{project.title}</span>
              {project.subtitle && (
                <span class="index__subtitle">— {project.subtitle}</span>
              )}
            </div>
            <div class="index__category">{project.category}</div>
          </a>
        ))
      }
    </div>
  </section>

  <div class="meta">
    <div>{sorted.length} projects</div>
    <div>Madrid · {year}</div>
  </div>

  <script>
    function initSort() {
      const head = document.querySelector(".index__head");
      const list = document.querySelector("[data-list]");
      if (!head || !list || list.dataset.ready) return;
      list.dataset.ready = "1";

      const rows = Array.from(list.children);
      let key = "year";
      let dir = -1;

      const valueOf = (el, k) =>
        k === "year" ? Number(el.dataset.year) : el.dataset[k];

      const apply = () => {
        [...rows]
          .sort((a, b) => {
            const va = valueOf(a, key);
            const vb = valueOf(b, key);
            if (va < vb) return -1 * dir;
            if (va > vb) return 1 * dir;
            return 0;
          })
          .forEach((row) => list.appendChild(row));
      };

      head.querySelectorAll("[data-sort]").forEach((col) => {
        col.addEventListener("click", () => {
          const k = col.dataset.sort;
          if (k === key) {
            dir *= -1;
          } else {
            key = k;
            dir = k === "year" ? -1 : 1;
          }
          head.querySelectorAll("[data-sort]").forEach((c) =>
            c.setAttribute("aria-pressed", c === col ? "true" : "false")
          );
          apply();
        });
        col.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); col.click(); }
        });
      });
    }
    if (document.readyState === "loading")
      document.addEventListener("DOMContentLoaded", initSort);
    else initSort();
  </script>
</Base>
