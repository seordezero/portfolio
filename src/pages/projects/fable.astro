---
import Base from "../../layouts/Base.astro";
---

<Base
  title="faBle — Sebastián Ortiz de Zevallos"
  description="Self-assembling CNC furniture designed during the pandemic."
  currentPage="projects"
>
  <article class="project">
    <div class="project__year">2020 · Design</div>
    <h1 class="project__title">faBle</h1>
    <p class="project__subtitle">Entrepreneurship · with Moisés Lázaro</p>

    <div class="project__body">
      <p>
        faBle started during the pandemic to offer a solution to the increasing
        demand for furniture that could easily adapt regular house spaces into
        remote working stations.
      </p>

      <p>
        We wanted to design interesting and complex self-assembling furniture
        that we could produce locally with a CNC in a small workshop. We
        dedicated a lot of time to creating unique designs and getting the most
        benefits out of this unfamiliar technology.
      </p>
    </div>

    <div class="project__gallery">
      <figure class="project__gallery-item">
        <img
          src="/images/fable/01.jpg"
          alt="faBle — self-assembling CNC furniture"
          loading="lazy"
        />
      </figure>
    </div>

    <div class="meta">
      <div><a href="/projects">← All projects</a></div>
      <div>2020</div>
    </div>
  </article>
</Base>
