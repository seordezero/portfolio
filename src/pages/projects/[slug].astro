---
import Base from "../../layouts/Base.astro";
import Gallery from "../../components/Gallery.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const linkLabel = project.link.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<Base
  title={`${project.title} — Sebastián Ortiz de Zevallos`}
  description={project.subtitle || project.title}
  currentPage="projects"
  square={project.square}
  backdrop={project.backdrop}
  ink={project.ink}
  layout="split"
>
  <article class="project">
    <div class="project__year">{project.year} · {project.category}</div>
    <h1 class="project__title">{project.title}</h1>
    {project.subtitle && <p class="project__subtitle">{project.subtitle}</p>}

    <div class="project__body">
      {project.body.map((block) =>
        block.type === "h2" ? <h2>{block.text}</h2> : <p>{block.text}</p>
      )}
    </div>

    {project.collaborators.length > 0 && (
      <div class="collab">
        <p class="collab__label">Collaborators</p>
        <p class="collab__names">{project.collaborators.join(", ")}</p>
      </div>
    )}

    {project.link && (
      <div class="collab">
        <p class="collab__label">Visit</p>
        <p class="collab__names">
          <a href={project.link} target="_blank" rel="noopener noreferrer">{linkLabel}</a>
        </p>
      </div>
    )}
  </article>

  <Gallery slot="gallery" slug={project.slug} images={project.images} alt={project.title} />
</Base>
